option_settings:
  # Container configuration
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "npm start"
    ProxyServer: nginx
    GzipCompression: "true"
    StaticFiles: "/static/=public/"

  # Health check configuration
  aws:elasticbeanstalk:environment:healthcheck:
    HealthCheck: "/api/health"
    Timeout: "5"
    Interval: "30"

  # Deployment settings
  aws:elasticbeanstalk:command:
    DeploymentTimeout: "900"
    IgnoreHealthCheck: "true"

  # Environment variables - CRITICAL: Update with your actual values
  aws:elasticbeanstalk:application:environment:
    PORT: "8080"
    NODE_ENV: "production"
    AWS_REGION: "ap-southeast-1"
    BEDROCK_MODEL_ID: "apac.anthropic.claude-3-haiku-20240307-v1:0"
    # IMPORTANT: Add your RDS database credentials
    DB_CONNECTION_STRING: "your-rds-endpoint.amazonaws.com"
    DB_PORT: "5432"
    DB_NAME: "forge"
    DB_USER: "postgres"
    DB_PASSWORD: "YourSecurePassword123!"
    # Session secret for JWT
    JWT_SECRET: "your-secure-jwt-secret-min-32-chars"

  # Log streaming
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: "true"
    RetentionDays: "7"