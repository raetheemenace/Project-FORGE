# Elastic Beanstalk Configuration
# For Node.js environment

option_settings:
  # Node.js version
  - option_name: NodeVersion
    option_value: 20
  
  # NPM start command
  - option_name: npm start
    option_value: npm start
  
  # Proxy configuration
  - option_name: ProxyServer
    option_value: nginx

# Environment variables (set these in EB console)
environment_variables:
  NODE_ENV: production
  PORT: 5000
