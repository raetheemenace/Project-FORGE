# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL RDS Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_CONNECTION_STRING=your_rds_endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=forge

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRY=24h

# AWS SDK Configuration (Bedrock & S3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-southeast-1

# AWS S3 Configuration
S3_BUCKET_NAME=forge-equipment-images
S3_PRESIGNED_URL_EXPIRY=604800

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# AWS Polly Configuration (TTS)
POLLY_VOICE_ID=Joanna
POLLY_OUTPUT_FORMAT=mp3

# AWS Transcribe Configuration (STT)
TRANSCRIBE_LANGUAGE_CODE=en-US

